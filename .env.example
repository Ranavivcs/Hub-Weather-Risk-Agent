# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=

# ---- Optional (defaults shown) ----
ANTHROPIC_MODEL=claude-haiku-5-5
DB_PATH=data/weather.db
# Max chat messages per client IP per hour (protects the API bill on a public URL)
CHAT_LIMIT_PER_HOUR=20
# End of the 5-year data window: an ISO date, or "latest" for a rolling window ending about a week ago
DATA_END=2025-12-31

# ---- Score-change alerts ----
# Where alerts are POSTed as JSON (leave empty to only log them)
ALERT_WEBHOOK_URL=
# Composite-score change (points) that triggers an alert
ALERT_THRESHOLD=1.0
# Shared secret for POST /api/alerts/check (header X-Alert-Token); leave empty to disable the endpoint
ALERT_TOKEN=
