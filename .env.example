# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
# Optional overrides
ANTHROPIC_MODEL=claude-haiku-5-5
DB_PATH=data/weather.db
# Bonus: where score-change alerts are POSTed (leave empty to disable)
ALERT_WEBHOOK_URL=

# Max chat messages per client IP per hour (protects the API bill on a public URL)
CHAT_LIMIT_PER_HOUR=20
